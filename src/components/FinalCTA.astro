---
import Icon from './Icon.astro';
import { waLink } from '../config/site';
---

<section class="relative py-24">
  <div class="container-site">
    <div
      class="relative overflow-hidden rounded-xl border border-border-soft bg-bg-surface px-6 py-16 text-center sm:px-12"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(200,241,53,0.12),transparent_60%)]"
      >
      </div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="section-title">
          Pronto para colocar seu negócio para
          <span class="text-brand"> rodar online</span>?
        </h2>
        <p class="mt-4 text-lg text-text-secondary">
          Fale com a Atlas e descubra o que dá para construir para o seu negócio.
          Sem enrolação.
        </p>
        <div class="mt-8 flex justify-center">
          <a
            href={waLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary px-8 py-4 text-base"
          >
            <Icon name="message-circle" size={20} />
            Falar no WhatsApp agora
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

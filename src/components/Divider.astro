---
/**
 * Divisor animado entre seções: linha gradiente lime que "desenha" do centro
 * ao entrar na viewport (usa o reveal global via [data-reveal] + .is-visible).
 */
---

<div class="container-site" aria-hidden="true">
  <div class="divider" data-reveal>
    <span class="divider__line"></span>
    <span class="divider__dot"></span>
  </div>
</div>

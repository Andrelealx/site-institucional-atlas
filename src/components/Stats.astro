---
import { stats } from '../data/stats';
---

<section id="numeros" class="relative py-20">
  <!-- Divisor gradiente lime no topo -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand/50 to-transparent"></div>

  <div class="container-site">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div
          class="group relative overflow-hidden rounded-xl border border-border-soft bg-bg-surface/40 p-6 text-center transition hover:border-brand/40"
          data-reveal
          data-reveal-delay={i % 4}
        >
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(200,241,53,0.10),transparent_70%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          <div
            class="relative font-display text-4xl font-bold tracking-tight text-brand sm:text-5xl"
            data-count={s.value}
            data-suffix={s.suffix ?? ''}
          >
            0{s.suffix ?? ''}
          </div>
          <p class="relative mt-3 text-sm leading-snug text-text-secondary">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

---
/**
 * Visual do hero: fluxo de automação (Cliente → WhatsApp → Atlas → Site/Venda).
 * Nós conectados por linhas com "pulso" lime correndo (dash animado). Comunica o
 * que a Atlas faz — automação/integração — com cara tecnológica. Puro SVG+CSS,
 * leve, e o movimento para sob prefers-reduced-motion.
 */
---

<div class="af card relative overflow-hidden !p-5">
  <!-- barra de janela -->
  <div class="mb-4 flex items-center gap-2">
    <span class="h-2.5 w-2.5 rounded-full bg-border-soft"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-border-soft"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-brand/60"></span>
    <span class="ml-2 text-[0.65rem] font-medium uppercase tracking-[0.18em] text-text-secondary">
      Automação Atlas
    </span>
    <span class="ml-auto inline-flex items-center gap-1.5 text-[0.65rem] font-semibold text-brand">
      <span class="af-live h-1.5 w-1.5 rounded-full bg-brand"></span>
      ao vivo
    </span>
  </div>

  <div class="af-stage relative mx-auto aspect-[5/6] w-full max-w-[320px]">
    <!-- conectores -->
    <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 120" fill="none" aria-hidden="true">
      <g stroke="#262A33" stroke-width="0.8" stroke-linecap="round">
        <path d="M50 20 L50 37" />
        <path d="M50 53 L50 70" />
        <path d="M44 86 L28 100" />
        <path d="M56 86 L72 100" />
      </g>
      <g class="af-flow" stroke="#C8F135" stroke-width="1.1" stroke-linecap="round">
        <path d="M50 20 L50 37" />
        <path d="M50 53 L50 70" style="animation-delay:.15s" />
        <path d="M44 86 L28 100" style="animation-delay:.45s" />
        <path d="M56 86 L72 100" style="animation-delay:.6s" />
      </g>
    </svg>

    <!-- nós -->
    <div class="af-node" style="left:50%;top:8.3%">
      <span class="af-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
      </span>
      Cliente
    </div>

    <div class="af-node" style="left:50%;top:37.5%">
      <span class="af-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2.1-5.7A8.4 8.4 0 1 1 21 11.5Z"/></svg>
      </span>
      WhatsApp
    </div>

    <!-- hub Atlas -->
    <div class="af-node af-hub" style="left:50%;top:65%">
      <span class="af-ico af-ico-hub">
        <svg viewBox="0 0 100 100"><path d="M50 24 L74 46 L64 46 L50 33 L36 46 L26 46 Z" fill="currentColor"/><path d="M50 44 L74 66 L64 66 L50 53 L36 66 L26 66 Z" fill="currentColor"/></svg>
      </span>
      Atlas
    </div>

    <div class="af-node" style="left:24%;top:90%">
      <span class="af-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/></svg>
      </span>
      Site no ar
    </div>

    <div class="af-node" style="left:76%;top:90%">
      <span class="af-ico af-ico-ok">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </span>
      Venda
    </div>
  </div>
</div>

<style>
  .af-node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    padding: 0.3rem 0.6rem 0.3rem 0.3rem;
    border: 1px solid #262a33;
    border-radius: 9999px;
    background: #16181d;
    font-size: 0.72rem;
    font-weight: 600;
    color: #f4f5f7;
    box-shadow: 0 6px 18px -10px rgba(0, 0, 0, 0.7);
  }
  .af-ico {
    display: inline-flex;
    height: 1.5rem;
    width: 1.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #0a0b0d;
    color: #9ca3af;
  }
  .af-ico svg {
    height: 0.9rem;
    width: 0.9rem;
  }
  .af-ico-ok {
    color: #c8f135;
  }
  .af-hub {
    background: #c8f135;
    color: #0a0b0d;
    border-color: #c8f135;
    font-weight: 700;
    padding: 0.35rem 0.8rem 0.35rem 0.35rem;
    box-shadow: 0 0 26px -4px rgba(200, 241, 53, 0.55);
    animation: af-hub-pulse 2.6s ease-in-out infinite;
  }
  .af-ico-hub {
    background: #0a0b0d;
    color: #c8f135;
  }
  .af-ico-hub svg {
    height: 1rem;
    width: 1rem;
  }
  /* pulso correndo pelos fios */
  .af-flow path {
    stroke-dasharray: 5 13;
    stroke-dashoffset: 36;
    animation: af-dash 1.4s linear infinite;
    filter: drop-shadow(0 0 2px rgba(200, 241, 53, 0.7));
  }
  .af-live {
    animation: af-blink 1.6s ease-in-out infinite;
  }
  @keyframes af-dash {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes af-hub-pulse {
    0%,
    100% {
      box-shadow: 0 0 22px -6px rgba(200, 241, 53, 0.45);
    }
    50% {
      box-shadow: 0 0 30px 0 rgba(200, 241, 53, 0.7);
    }
  }
  @keyframes af-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .af-flow path,
    .af-hub,
    .af-live {
      animation: none;
    }
    .af-flow path {
      stroke-dashoffset: 0;
    }
  }
</style>

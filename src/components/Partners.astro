---
import { partners } from '../data/partners';

const hasReal = partners.length > 0;
const items = hasReal
  ? partners
  : Array.from({ length: 6 }, (_, i) => ({ name: `Parceiro ${i + 1}`, src: '', url: undefined }));

// Duplica a lista pra o loop do marquee ficar contínuo.
const loop = [...items, ...items];
---

<section id="parceiros" class="relative border-y border-border-soft/60 py-14">
  <div class="container-site">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-text-secondary" data-reveal>
      Negócios que confiam na Atlas
    </p>

    <div class="marquee mt-8" data-reveal>
      <ul class="marquee__track" role="list">
        {loop.map((p, i) => {
          const inner = p.src ? (
            <span class="partner-chip">
              <img
                src={p.src}
                alt=""
                loading="lazy"
                decoding="async"
                width="44"
                height="44"
                class="partner-avatar"
              />
              <span class="partner-name">{p.name}</span>
            </span>
          ) : (
            <span class="partner-chip">
              <svg viewBox="0 0 100 100" class="partner-avatar p-2 text-text-secondary" aria-hidden="true">
                <path d="M50 24 L74 46 L64 46 L50 33 L36 46 L26 46 Z" fill="currentColor" />
                <path d="M50 44 L74 66 L64 66 L50 53 L36 66 L26 66 Z" fill="currentColor" />
              </svg>
              <span class="partner-name">{p.name}</span>
            </span>
          );
          return (
            <li class="marquee__item" aria-hidden={i >= items.length ? 'true' : undefined}>
              {p.url ? (
                <a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
                  {inner}
                </a>
              ) : (
                inner
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 1.25rem;
    animation: marquee 42s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__item {
    flex: 0 0 auto;
  }
  .partner-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 1.1rem 0.4rem 0.4rem;
    border: 1px solid #262a33;
    border-radius: 9999px;
    background: rgba(22, 24, 29, 0.6);
    white-space: nowrap;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .marquee__item:hover .partner-chip {
    border-color: rgba(200, 241, 53, 0.45);
    background: rgba(22, 24, 29, 0.9);
  }
  .partner-avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    object-fit: cover;
    flex-shrink: 0;
    background: #0a0b0d;
  }
  .partner-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: #9ca3af;
    transition: color 0.3s ease;
  }
  .marquee__item:hover .partner-name {
    color: #f4f5f7;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
      width: 100%;
    }
    .marquee__item[aria-hidden='true'] {
      display: none;
    }
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>

---
import { partners } from '../data/partners';

// Sem logos reais ainda → mostra placeholders neutros pra visualizar o layout.
const hasReal = partners.length > 0;
const items = hasReal
  ? partners
  : Array.from({ length: 6 }, (_, i) => ({ name: `Parceiro ${i + 1}`, src: '', url: undefined }));

// Duplica a lista pra o loop do marquee ficar contínuo.
const loop = [...items, ...items];
---

<section id="parceiros" class="relative border-y border-border-soft/60 py-14">
  <div class="container-site">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-text-secondary" data-reveal>
      Negócios que confiam na Atlas
    </p>

    <div class="marquee mt-8" data-reveal>
      <ul class="marquee__track" role="list">
        {loop.map((p, i) => (
          <li class="marquee__item" aria-hidden={i >= items.length ? 'true' : undefined}>
            {p.src ? (
              <img
                src={p.src}
                alt={p.name}
                loading="lazy"
                decoding="async"
                class="partner-logo h-8 w-auto max-w-[150px] object-contain"
              />
            ) : (
              <span class="partner-placeholder">
                <svg viewBox="0 0 100 100" class="h-6 w-6 shrink-0" aria-hidden="true">
                  <path d="M50 24 L74 46 L64 46 L50 33 L36 46 L26 46 Z" fill="currentColor" />
                  <path d="M50 44 L74 66 L64 66 L50 53 L36 66 L26 66 Z" fill="currentColor" />
                </svg>
                <span class="text-sm font-semibold tracking-wide">{p.name}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>

    {!hasReal && (
      <p class="mt-6 text-center text-xs text-text-secondary/60">
        Placeholders — troque pelos logos reais em <code>src/data/partners.ts</code>.
      </p>
    )}
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    /* Esfuma as bordas laterais. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 3.5rem;
    animation: marquee 32s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__item {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    color: #9ca3af;
    transition: color 0.3s ease;
  }
  .marquee__item:hover {
    color: #f4f5f7;
  }
  .partner-placeholder {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
  }
  /* Logos reais entram monocromáticos e ganham cor/opacidade no hover. */
  .partner-logo {
    filter: grayscale(1) brightness(1.6);
    opacity: 0.6;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }
  .marquee__item:hover .partner-logo {
    filter: none;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2.5rem 3rem;
      width: 100%;
    }
    /* Sem animação, a segunda cópia vira duplicata visível — esconde. */
    .marquee__item[aria-hidden='true'] {
      display: none;
    }
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>

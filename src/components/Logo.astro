---
/**
 * Lockup horizontal oficial da marca (chevron lime + "Atlas TECNOLOGIAS"),
 * versão negativa (texto branco) — para uso sobre fundo escuro.
 * Arquivo: /public/images/atlas-logo.svg (kit oficial ATLAS_Marca_Grafica).
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<img
  src="/images/atlas-logo.svg"
  alt="Atlas Tecnologias"
  width="120"
  height="40"
  class={`h-9 w-auto sm:h-10 ${className}`}
/>

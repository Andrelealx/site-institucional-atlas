---
import Icon from './Icon.astro';
import { waLink } from '../config/site';
---

<a
  href={waLink()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp"
  data-fb-event="Contact"
  class="fixed bottom-5 right-5 z-30 inline-flex h-14 w-14 items-center justify-center rounded-full bg-brand text-bg-base shadow-glow transition hover:scale-105 hover:brightness-95"
>
  <Icon name="message-circle" size={26} />
</a>

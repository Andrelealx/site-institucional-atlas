---
/**
 * Ícone inline no estilo lucide (linha, minimalista).
 * Apenas os ícones usados no site estão mapeados — evita dependência extra.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className = '' } = Astro.props;

// Trechos internos de cada ícone (paths do lucide.dev, ISC License).
const paths: Record<string, string> = {
  monitor:
    '<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>',
  'layout-grid':

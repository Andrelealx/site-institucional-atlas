---
import Icon from './Icon.astro';
import ImageWithFallback from './ImageWithFallback.astro';
import { projects } from '../data/projects';

/**
 * Prints do portfólio vivem em `src/assets/portfolio/` para passarem pelo
 * pipeline do Astro (WebP + srcset). `projects.ts` continua guardando o caminho
 * público (`/images/portfolio-x.jpg`) — casamos os dois pelo nome do arquivo,
 * então adicionar um case segue sendo só soltar o print e editar os dados.
 * Sem arquivo correspondente, cai no `<img>` simples de /public.
 */
const assets = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portfolio/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const assetByFileName = new Map(
  Object.entries(assets).map(([path, mod]) => [path.split('/').pop()!, mod.default])
);

/**
 * Mesma grade serve a home (amostra curada + link para a página) e a página
 * /portfolio (lista completa, sem cabeçalho de seção — a página tem o seu).
 */
interface Props {
  /** Quantidade máxima de cases. Ausente = todos. */
  limit?: number;
  /** Exibe o CTA "Ver todos os projetos" abaixo da grade. */
  showAllLink?: boolean;
  /** Cabeçalho da seção (eyebrow + h2 + texto). */
  showHeader?: boolean;
}

const { limit, showAllLink = false, showHeader = true } = Astro.props;

// Sem contagem de projetos em texto: número exato envelhece mal e a própria
// grade já mostra o volume.
const visibleProjects = limit ? projects.slice(0, limit) : projects;
---

<!-- Sem cabeçalho (página /portfolio), o topo vem colado no hero da página. -->
<section
  id="portfolio"
  class:list={['relative pb-24', showHeader ? 'pt-24' : 'pt-2']}
>
  <div class="container-site">
    {
      showHeader && (
        <div class="max-w-2xl" data-reveal>
          <span class="eyebrow">Portfólio</span>
          <h2 class="section-title mt-3">Trabalhos que entregam resultado</h2>
          <p class="mt-4 text-lg text-text-secondary">
            Uma amostra do que já construímos para negócios de todo o Brasil.
          </p>
        </div>
      )
    }

    <div
      class:list={[
        'grid gap-6 sm:grid-cols-2 lg:grid-cols-3',
        showHeader ? 'mt-12' : '',
      ]}
    >
      {
        visibleProjects.map((project, i) => {
          const Tag = project.url ? 'a' : 'div';
          const image = project.image
            ? (assetByFileName.get(project.image.split('/').pop()!) ?? project.image)
            : undefined;
          return (
            <Tag
              {...(project.url
                ? { href: project.url, target: '_blank', rel: 'noopener noreferrer' }
                : {})}
              class="group card overflow-hidden p-0"
              data-reveal
              data-reveal-delay={i % 3}
            >
              <div class="overflow-hidden">
                {image ? (
                  <div class="transition-transform duration-500 group-hover:scale-105">
                    <ImageWithFallback
                      src={image}
                      alt={project.title}
                      ratio="aspect-video"
                    />
                  </div>
                ) : (
                  <div class="relative flex aspect-video items-center justify-center overflow-hidden bg-gradient-to-br from-bg-surface-2 to-bg-base">
                    {/* Grade sutil de fundo */}
                    <div
                      class="absolute inset-0 opacity-[0.07]"
                      style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:28px 28px;"
                    />
                    {/* Brilho lime */}
                    <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-brand/20 blur-3xl" />
                    <span class="relative flex h-20 w-20 items-center justify-center rounded-2xl border border-brand/30 bg-brand/10 text-brand transition group-hover:scale-105">
                      <Icon name={project.icon ?? 'code-2'} size={36} />
                    </span>
                  </div>
                )}
              </div>
              <div class="flex flex-col gap-2 p-5">
                <span class="text-xs font-semibold uppercase tracking-wider text-brand">
                  {project.category}
                </span>
                <h3 class="flex items-center gap-1.5 font-display text-lg font-bold text-text-primary">
                  {project.title}
                  {project.url && (
                    <Icon
                      name="arrow-up-right"
                      size={16}
                      class="opacity-0 transition group-hover:opacity-100"
                    />
                  )}
                </h3>
                <p class="text-sm leading-relaxed text-text-secondary">
                  {project.description}
                </p>
                {project.tags && project.tags.length > 0 && (
                  <div class="mt-2 flex flex-wrap gap-2">
                    {project.tags.map((tag) => (
                      <span class="rounded-full border border-border-soft px-2.5 py-1 text-xs text-text-secondary">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </Tag>
          );
        })
      }
    </div>

    {
      showAllLink && (
        <div class="mt-12 flex justify-center" data-reveal>
          <a href="/portfolio" class="btn-secondary">
            Ver todos os projetos
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      )
    }
  </div>
</section>

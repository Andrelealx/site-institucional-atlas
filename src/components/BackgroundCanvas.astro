---
// Canvas de fundo da Constelação Atlas. Fixo atrás de todo o conteúdo (-z-10),
// transparente, sem captura de eventos. O motor (three.js) só carrega e inicia
// quando as guardas de performance passam — caso contrário fica o grid+glow CSS.
---

<div
  id="bg-canvas-wrap"
  class="pointer-events-none fixed inset-0 -z-10 opacity-0 transition-opacity duration-1000"
  aria-hidden="true"
>
  <canvas id="bg-canvas" class="h-full w-full"></canvas>
</div>

<script>
  const wrap = document.getElementById('bg-canvas-wrap');
  const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement | null;

  // Guardas de performance / acessibilidade — em qualquer falha, não inicia.
  // Mobile roda com versão leve (menos partículas — ver constellation.ts).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nav = navigator as Navigator & { deviceMemory?: number };
  const lowMem = typeof nav.deviceMemory === 'number' && nav.deviceMemory <= 2;
  const noWebGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return true;
    }
  })();

  if (canvas && wrap && !reduce && !lowMem && !noWebGL) {
    // Só carrega o three.js (chunk pesado) DEPOIS do load + quando a thread
    // estiver ociosa. Assim não compete com a primeira pintura / interatividade.
    const start = () =>
      import('../scripts/constellation')
        .then((m) => {
          m.initConstellation(canvas);
          wrap.classList.remove('opacity-0'); // fade-in suave após inicializar
        })
        .catch(() => {
          /* silencioso — fallback é o fundo CSS já existente */
        });

    // Carrega o three.js (chunk pesado) só na PRIMEIRA interação do usuário —
    // scroll, mouse ou toque. Mantém o carregamento inicial leve; quem não
    // interage recebe o fundo via fallback ocioso mais tarde.
    let triggered = false;
    const evs = ['pointermove', 'scroll', 'touchstart', 'wheel', 'keydown'] as const;
    const cleanup = () => evs.forEach((e) => window.removeEventListener(e, trigger));
    function trigger() {
      if (triggered) return;
      triggered = true;
      cleanup();
      start();
    }
    evs.forEach((e) => window.addEventListener(e, trigger, { once: true, passive: true }));
    // Fallback: sessão sem interação nenhuma recebe o fundo depois de ocioso.
    setTimeout(() => {
      if ('requestIdleCallback' in window) (window as any).requestIdleCallback(trigger, { timeout: 2000 });
      else trigger();
    }, 6000);
  }
</script>

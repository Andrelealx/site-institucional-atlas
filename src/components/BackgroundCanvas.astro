---
// Canvas de fundo da Constelação Atlas. Fixo atrás de todo o conteúdo (-z-10),
// transparente, sem captura de eventos. Motor em Canvas2D (leve) carregado após
// o load, quando a thread está ociosa. Se as guardas falharem, fica só o CSS.
---

<div
  id="bg-canvas-wrap"
  class="pointer-events-none fixed inset-0 -z-10 opacity-0 transition-opacity duration-1000"
  aria-hidden="true"
>
  <canvas id="bg-canvas" class="h-full w-full"></canvas>
</div>

<script>
  const wrap = document.getElementById('bg-canvas-wrap');
  const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement | null;

  // Guardas de acessibilidade/hardware — em qualquer falha, não inicia.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nav = navigator as Navigator & { deviceMemory?: number };
  const lowMem = typeof nav.deviceMemory === 'number' && nav.deviceMemory <= 1;

  if (canvas && wrap && !reduce && !lowMem) {
    const start = () =>
      import('../scripts/constellation')
        .then((m) => {
          m.initConstellation(canvas);
          wrap.classList.remove('opacity-0'); // fade-in suave após inicializar
        })
        .catch(() => {
          /* silencioso — fallback é o fundo CSS já existente */
        });

    // Chunk é minúsculo (Canvas2D, sem three.js) — carrega no ocioso após o load,
    // sem competir com a primeira pintura e sem travar a interação.
    const idle = () =>
      'requestIdleCallback' in window
        ? (window as any).requestIdleCallback(start, { timeout: 1500 })
        : setTimeout(start, 400);

    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }
</script>

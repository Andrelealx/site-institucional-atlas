---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import {
  waLink,
  mailLink,
  instagramLink,
  EMAIL,
  PHONE_DISPLAY,
  PHONE_TEL,
  SITE,
} from '../config/site';
import { NAV_LINKS as navLinks } from '../config/nav';

const instagram = instagramLink();
const year = new Date().getFullYear();
---

<footer class="border-t border-border-soft bg-bg-base py-14">
  <div class="container-site">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <Logo />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-text-secondary">
          Sites, sistemas e automações sob medida. Presença digital
          que trabalha pelo seu negócio.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text-primary">Navegação</h3>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-text-secondary transition hover:text-brand"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text-primary">Contato</h3>
        <ul class="mt-4 flex flex-col gap-3">
          <li>
            <a
              href={waLink()}
              target="_blank"
              rel="noopener noreferrer"
              data-fb-event="Contact"
              class="inline-flex items-center gap-2 text-sm text-text-secondary transition hover:text-brand"
            >
              <Icon name="message-circle" size={16} />
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href={`tel:${PHONE_TEL}`}
              class="inline-flex items-center gap-2 text-sm text-text-secondary transition hover:text-brand"
            >
              <Icon name="phone" size={16} />
              {PHONE_DISPLAY}
            </a>
          </li>
          <li>
            <a
              href={mailLink()}
              class="inline-flex items-center gap-2 text-sm text-text-secondary transition hover:text-brand"
            >
              <Icon name="mail" size={16} />
              {EMAIL}
            </a>
          </li>
          {
            instagram && (
              <li>
                <a
                  href={instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm text-text-secondary transition hover:text-brand"
                >
                  <Icon name="instagram" size={16} />
                  Instagram
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border-soft pt-6 sm:flex-row"
    >
      <div class="flex flex-col items-center gap-1 sm:items-start">
        <p class="text-xs text-text-secondary">
          © {year} Atlas Tecnologias. Todos os direitos reservados.
        </p>
        <p class="text-xs text-text-secondary">
          {SITE.legalName} · CNPJ {SITE.cnpj}
        </p>
        <address class="text-center text-xs not-italic text-text-secondary sm:text-left">
          {SITE.street}, {SITE.streetComplement} · {SITE.district} ·
          {SITE.city}/{SITE.state} · CEP {SITE.postalCode}
        </address>
      </div>
      <div class="flex items-center gap-4">
        <a
          href="/politica-de-privacidade"
          class="text-xs text-text-secondary transition hover:text-brand"
        >
          Política de Privacidade
        </a>
        <a
          href="/termos-de-uso"
          class="text-xs text-text-secondary transition hover:text-brand"
        >
          Termos de Uso
        </a>
      </div>
    </div>
  </div>
</footer>

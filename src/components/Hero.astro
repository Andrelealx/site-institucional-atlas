---
import Icon from './Icon.astro';
import AutomationFlow from './AutomationFlow.astro';
import { waLink } from '../config/site';
---

<section
  id="inicio"
  class="relative flex min-h-[85vh] items-center overflow-hidden pt-16"
>
  <!-- Grid sutil + glow radial lime -->
  <div class="pointer-events-none absolute inset-0 bg-grid-soft bg-[size:48px_48px] opacity-40"></div>
  <div
    class="pointer-events-none absolute -top-32 left-1/2 h-[480px] w-[480px] -translate-x-1/2 rounded-full bg-brand/10 blur-[120px]"
  >
  </div>

  <div class="container-site relative grid items-center gap-12 py-16 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <span class="eyebrow animate-fade-up">
        <span class="h-1.5 w-1.5 rounded-full bg-brand"></span>
        Região Serrana - RJ
      </span>

      <h1
        class="mt-5 text-4xl font-bold leading-[1.08] tracking-tight text-text-primary animate-fade-up sm:text-5xl lg:text-6xl"
      >
        Presença digital que
        <span class="text-brand" data-scramble>trabalha pelo seu negócio</span>.
      </h1>

      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-text-secondary animate-fade-up"
      >
        A Atlas constrói a estrutura digital de negócios locais — sites que
        convertem, sistemas sob medida e automações. Coisa que funciona e dá
        retorno, não site bonito parado.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4 animate-fade-up">
        <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn-primary">
          <Icon name="message-circle" size={18} />
          Falar no WhatsApp
        </a>
        <a href="#portfolio" class="btn-secondary" data-magnetic>
          Ver portfólio
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>

    <!-- Elemento visual: fluxo de automação (desktop e mobile) -->
    <div class="lg:col-span-5">
      <div class="relative mx-auto max-w-xs animate-fade-up lg:max-w-none" data-parallax="0.05">
        <AutomationFlow />
      </div>
    </div>
  </div>
</section>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Icon from '../components/Icon.astro';
import { waLink, SITE } from '../config/site';

// Landing de tráfego pago — plano Expert para DENTISTAS.
// CTA de WhatsApp dispara o evento `Lead` (principal da campanha).
const leadMsg =
  'Oi! Sou dentista e quero o plano Expert. Pode me passar a proposta?';
const wa = waLink(leadMsg);

const dores = [
  'Paciente pesquisa seu nome no Google e não te encontra — ou acha um perfil vazio.',
  'Você depende de indicação, mas quem chega novo não tem onde confiar antes de marcar.',
  'Ter site virou obrigação, mas ninguém quer pagar mensalidade eterna por isso.',
];

const entregas = [
  'Site profissional (até 4 páginas)',
  'Agendamento online integrado',
  'WhatsApp + redes sociais integrados',
  'Depoimentos de pacientes em destaque',
  'Hospedagem 12 meses inclusa',
  'Domínio .com.br no 1º ano',
  'SEO local + Google Meu Negócio',
  'Aparecer nas buscas "dentista + sua cidade"',
];
---

<Layout
  title="Site para Dentistas — Plano Expert | Atlas Tecnologias"
  description="Site profissional para dentistas, com agendamento e presença no Google. Pago uma vez por ano, sem mensalidade. Proposta pelo WhatsApp em 24h."
  path="/expert-dentistas"
>
  <Header />

  <main id="main-content" class="overflow-hidden pt-16">
    <!-- HERO -->
    <section class="relative">
      <div class="container-site py-20 sm:py-28">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <span class="eyebrow justify-center">
            <Icon name="check-circle" size={14} /> Plano Expert · Odontologia
          </span>
          <h1
            class="mt-5 font-display text-4xl font-bold leading-[1.1] tracking-tight text-text-primary sm:text-5xl"
          >
            Seu consultório merece um site que traz paciente — não só um
            <span class="text-brand">cartão de visita digital</span>.
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-lg text-text-secondary">
            Site profissional para dentistas, com agendamento e presença no
            Google. Pago uma vez por ano, <strong class="text-text-primary"
              >sem mensalidade</strong
            >.
          </p>
          <div class="mt-9 flex flex-col items-center gap-3">
            <a
              href={wa}
              target="_blank"
              rel="noopener noreferrer"
              data-fb-event="Lead"
              class="btn-primary px-8 py-4 text-base"
            >
              <Icon name="message-circle" size={20} />
              Quero meu site — falar no WhatsApp
            </a>
            <p class="text-xs text-text-secondary">
              Resposta em até 24h · sem compromisso
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- A DOR -->
    <section class="border-t border-border-soft/60 bg-bg-surface/30">
      <div class="container-site py-16 sm:py-20">
        <h2 class="section-title max-w-2xl" data-reveal>
          Se você é dentista, provavelmente já passou por isso
        </h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {
            dores.map((d, i) => (
              <div
                class="rounded-2xl border border-border-soft bg-bg-surface p-6"
                data-reveal
                data-reveal-delay={i % 3}
              >
                <span class="text-brand">
                  <Icon name="x" size={22} />
                </span>
                <p class="mt-4 text-sm leading-relaxed text-text-secondary">
                  {d}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- A SOLUÇÃO -->
    <section class="container-site py-16 sm:py-20">
      <div class="max-w-2xl" data-reveal>
        <span class="eyebrow">A solução</span>
        <h2 class="section-title mt-3">
          Tudo que seu consultório precisa online, num pacote só
        </h2>
        <p class="mt-4 text-lg text-text-secondary">
          Você cuida dos pacientes. A gente cuida da sua presença digital — do
          agendamento ao Google.
        </p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          entregas.map((f, i) => (
            <li
              class="flex items-start gap-3 rounded-xl border border-border-soft bg-bg-surface p-4"
              data-reveal
              data-reveal-delay={i % 2}
            >
              <span class="mt-0.5 shrink-0 text-brand">
                <Icon name="check-circle" size={18} />
              </span>
              <span class="text-sm text-text-primary">{f}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- A OFERTA -->
    <section class="border-y border-border-soft/60 bg-bg-surface/30">
      <div class="container-site py-16 sm:py-20">
        <div
          class="mx-auto max-w-3xl overflow-hidden rounded-2xl border border-brand/50 bg-bg-surface p-8 text-center shadow-glow sm:p-10"
          data-reveal
        >
          <span
            class="inline-flex items-center gap-1.5 rounded-full border border-brand/40 bg-brand/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand"
          >
            Sem mensalidade
          </span>
          <p class="mt-6 font-display text-5xl font-bold text-brand">
            R$ 1.197<span class="text-2xl text-text-secondary">/ano</span>
          </p>
          <p class="mt-2 text-lg text-text-primary">
            Sem mensalidade. Sem surpresa.
          </p>
          <div
            class="mx-auto mt-6 flex max-w-md flex-col gap-2 text-sm text-text-secondary"
          >
            <p>Ou <strong class="text-text-primary">12x de R$ 99,75</strong> no cartão.</p>
            <p>Setup incluso — sem custo extra de criação.</p>
            <p>
              Renovação anual de <strong class="text-text-primary">R$ 797</strong>
              (também parcelável). Sem letra miúda.
            </p>
          </div>
          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            data-fb-event="Lead"
            class="btn-primary mt-8 px-8 py-4 text-base"
          >
            <Icon name="message-circle" size={20} />
            Quero meu site — falar no WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- PROVA / CONFIANÇA -->
    <section class="container-site py-16 sm:py-20">
      <div class="mx-auto max-w-3xl" data-reveal>
        <span class="eyebrow">Confiança</span>
        <h2 class="section-title mt-3">Uma empresa por trás do seu site</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-border-soft bg-bg-surface p-6">
            <span class="text-brand"><Icon name="check-circle" size={20} /></span>
            <p class="mt-3 text-sm font-semibold text-text-primary">
              Entrega em até 15 dias úteis
            </p>
            <p class="mt-1 text-sm text-text-secondary">
              Prazo combinado e acompanhado de perto, do briefing ao site no ar.
            </p>
          </div>
          <div class="rounded-xl border border-border-soft bg-bg-surface p-6">
            <span class="text-brand"><Icon name="message-circle" size={20} /></span>
            <p class="mt-3 text-sm font-semibold text-text-primary">
              Suporte direto via WhatsApp
            </p>
            <p class="mt-1 text-sm text-text-secondary">
              Falou com gente de verdade — sem robô, sem ticket que some.
            </p>
          </div>
        </div>

        <!--
          PENDÊNCIA (docs/12): substituir por depoimento real de cliente dentista
          quando houver. Sem inventar prova social.
        -->
        <div
          class="mt-4 rounded-xl border border-dashed border-border-soft bg-bg-base/40 p-6 text-center"
        >
          <p class="text-sm text-text-secondary">
            Espaço reservado para depoimento de paciente/dentista atendido.
          </p>
        </div>

        <p class="mt-8 text-center text-xs text-text-secondary">
          {SITE.legalName} · CNPJ {SITE.cnpj} · {SITE.region}
        </p>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="border-t border-border-soft/60 bg-bg-surface/30">
      <div class="container-site py-16 text-center sm:py-20">
        <h2 class="section-title mx-auto max-w-2xl" data-reveal>
          Pronto para aparecer quando o paciente procurar?
        </h2>
        <a
          href={wa}
          target="_blank"
          rel="noopener noreferrer"
          data-fb-event="Lead"
          class="btn-primary mt-8 px-8 py-4 text-base"
          data-reveal
        >
          <Icon name="message-circle" size={20} />
          Falar no WhatsApp e receber proposta em 24h
        </a>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />

  <!-- ViewContent: interesse no produto (respeita o gate de consentimento) -->
  <script is:inline>
    (function () {
      function fire() {
        if (window.atlasTrack) window.atlasTrack('ViewContent');
      }
      if (document.readyState === 'complete') fire();
      else window.addEventListener('load', fire, { once: true });
    })();
  </script>
</Layout>

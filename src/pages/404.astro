---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página não encontrada — Atlas Tecnologias"
  description="A página que você procura não existe."
  path="/404"
>
  <main
    id="main-content"
    class="relative flex min-h-screen items-center justify-center overflow-hidden px-5"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-grid-soft bg-[size:48px_48px] opacity-30"
    >
    </div>
    <div
      class="pointer-events-none absolute left-1/2 top-1/3 h-[400px] w-[400px] -translate-x-1/2 rounded-full bg-brand/10 blur-[120px]"
    >
    </div>

    <div class="relative text-center">
      <svg viewBox="0 0 100 100" class="mx-auto h-16 w-16">
        <path d="M50 20 L78 46 L68 46 L50 30 L32 46 L22 46 Z" fill="#C8F135" />
        <path d="M50 42 L78 68 L68 68 L50 52 L32 68 L22 68 Z" fill="#C8F135" />
      </svg>
      <p class="mt-6 font-display text-6xl font-bold text-brand">404</p>
      <h1 class="mt-3 font-display text-2xl font-bold text-text-primary">
        Página não encontrada
      </h1>
      <p class="mx-auto mt-3 max-w-md text-text-secondary">
        O endereço não existe ou foi movido. Volte ao início e siga a navegação.
      </p>
      <a href="/" class="btn-primary mt-8">Voltar ao início</a>
    </div>
  </main>
</Layout>
